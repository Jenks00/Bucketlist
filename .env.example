# Copy this file to .env and fill in real values for your environment.
# Never commit your actual .env file.

# A long, random, secret string used for cryptographic signing.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value

# Set to False in production.
DJANGO_DEBUG=True

# Comma-separated list of hostnames allowed to serve the app.
# Example: DJANGO_ALLOWED_HOSTS=mybucketlist.herokuapp.com,www.mybucketlist.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
